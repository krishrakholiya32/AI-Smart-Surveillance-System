# Copy this file to .env and fill in your values
# Never commit .env to git

# ─── Auth ───────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ─── Resource limits ──────────────────────────────────────────
# Raise both to match your machine's actual core count for full-speed
# inference; lower them if you want to leave more headroom for other apps.
BACKEND_CPU_LIMIT=3
BACKEND_MEM_LIMIT=8G

# ─── Database (leave as-is for Docker Compose) ──────────────
DATABASE_URL=postgresql+asyncpg://surveillance:surveillance@db:5432/surveillance

# ─── Detection Tuning ───────────────────────────────────────
CONF_PERSON=0.50
CONF_WEAPON=0.45
RUN_THRESH_NORM=0.18
LOITER_SECS=8
CROWD_LIMIT=5
